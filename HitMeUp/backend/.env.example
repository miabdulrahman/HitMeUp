PORT=5000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,https://hit-me-up.vercel.app"
COOKIE_SAME_SITE="lax"
# Set to "none" for a frontend hosted on a different site in production.
COOKIE_DOMAIN=""
MONGO_URI=""
JWT_SECRET=""
NVIDIA_API_KEY=""
NVIDIA_MODEL=""
GOOGLE_CLIENT_ID=""
ADMIN_EMAIL="admin@hitmeup.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Platform Administrator"
SEED_VENDOR_PASSWORD=""
SEED_CLIENT_PASSWORD=""

# HitMeUp Pay: Simulated Payment Gateway Configuration
PAYMENT_SIMULATION_ENABLED=true
GATEWAY_SIGNING_SECRET="hitmeup_pay_signing_secret_academic_2026"
PAYMENT_FEE_PERCENT=0
ORDER_TTL_MINUTES=15
SIMULATED_PROCESSING_DELAY_MS=1000

# =========================================================================
# Email OTP Configuration (Registration Verification & Forgot Password)
# =========================================================================

# Option 0: Google Apps Script Webhook (Port 443 HTTPS - Free, sends via Gmail to ANY recipient!)
# Zero domain verification required. Immune to cloud firewalls on Render/Vercel.
GOOGLE_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

# Option A: Brevo REST API v3 (Port 443 HTTPS - Recommended for Render & Vercel!)
# Generates in Brevo -> SMTP & API -> API Keys -> Generate key (starts with xkeysib-)
# Sends 300 free emails/day to ANY recipient without requiring custom domain verification.
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="auth@mail.your-domain.com"
BREVO_SENDER_NAME="HitMeUp Security"

# Option B: Brevo SMTP Relay (Supports ports 2525, 587, 465)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER="c192fb001@smtp-brevo.com"
SMTP_PASS="xsmtpsib-your-smtp-key"
EMAIL_FROM="\"HitMeUp Security\" <auth@mail.your-domain.com>"
EMAIL_REPLY_TO="support@your-domain.com"

# Option C: Resend REST API (Port 443 HTTPS)
# NOTE: "onboarding@resend.dev" can ONLY send to your own registered account email.
# To send to all users, you must verify your custom domain in https://resend.com/domains
RESEND_API_KEY="re_123456789"
RESEND_FROM="HitMeUp Security <auth@mail.your-domain.com>"

# Option D: Direct Google Gmail SMTP (Port 465 SSL - Localhost only, blocked on Render)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-app-password"
