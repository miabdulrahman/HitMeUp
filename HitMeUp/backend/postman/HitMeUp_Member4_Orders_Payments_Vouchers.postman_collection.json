{
  "info": {
    "_postman_id": "hitmeup-member4-orders-payments-vouchers-2026",
    "name": "HitMeUp - Member 4 (Orders, Payments & Vouchers)",
    "description": "Postman API collection for Member 4 (Rushdhi). Covers Order creation, cancellation, business order analytics, Payment checkout & verification, Digital Voucher generation with QR, and Cashier QR scan preview & Redemption.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "business_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "deal_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "voucher_code",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Orders",
      "item": [
        {
          "name": "1. Create Order (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealId\": \"{{deal_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "2. Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "3. Get Single Order By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "4. Cancel Pending Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "cancel"]
            }
          }
        },
        {
          "name": "5. Get Business Orders & Revenue (Business Owner)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{business_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/orders/business",
              "host": ["{{base_url}}"],
              "path": ["orders", "business"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Payments",
      "item": [
        {
          "name": "1. Create Payment Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/create",
              "host": ["{{base_url}}"],
              "path": ["payments", "create"]
            }
          }
        },
        {
          "name": "2. Verify Payment (Success -> Generates Voucher)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{payment_id}}\",\n  \"transactionId\": \"TXN-DEMO-TEST123\",\n  \"success\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/verify",
              "host": ["{{base_url}}"],
              "path": ["payments", "verify"]
            }
          }
        },
        {
          "name": "3. Verify Payment (Failed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{payment_id}}\",\n  \"transactionId\": \"TXN-DEMO-FAIL\",\n  \"success\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/verify",
              "host": ["{{base_url}}"],
              "path": ["payments", "verify"]
            }
          }
        },
        {
          "name": "4. Get Payment By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/payments/{{payment_id}}",
              "host": ["{{base_url}}"],
              "path": ["payments", "{{payment_id}}"]
            }
          }
        },
        {
          "name": "5. Payment Webhook Callback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{payment_id}}\",\n  \"transactionId\": \"TXN-GATEWAY-HOOK\",\n  \"status\": \"SUCCESS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/webhook",
              "host": ["{{base_url}}"],
              "path": ["payments", "webhook"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Digital Vouchers & Redemption",
      "item": [
        {
          "name": "1. Get My Vouchers (Customer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/vouchers",
              "host": ["{{base_url}}"],
              "path": ["vouchers"]
            }
          }
        },
        {
          "name": "2. Get Single Voucher By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/vouchers/{{voucher_id}}",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "{{voucher_id}}"]
            }
          }
        },
        {
          "name": "3. Preview Voucher by Code (Cashier Scan View)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{business_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/vouchers/code/{{voucher_code}}",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "code", "{{voucher_code}}"]
            }
          }
        },
        {
          "name": "4. Redeem Voucher (Business Owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{business_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{voucher_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/vouchers/redeem",
              "host": ["{{base_url}}"],
              "path": ["vouchers", "redeem"]
            }
          }
        }
      ]
    }
  ]
}
